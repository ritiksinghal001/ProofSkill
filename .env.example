# Copy to .env. Placeholders only; never commit real secrets.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATA_DIR=./data

# Evaluator: "fixture" = transparent keyword heuristic (NOT an AI model). "anthropic" needs AI_API_KEY and is not exercised in this build.
AI_PROVIDER=fixture
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=45000

# Optional: raises the GitHub API rate limit for public repositories.
GITHUB_TOKEN=

# Assessment defaults (Proposed, see docs/DECISIONS.md)
MCQ_PER_SKILL=10
MCQ_TIMED=false
MCQ_MINUTES_PER_SKILL=15

# Upload limits (Proposed)
MAX_RESUME_MB=5
MAX_ZIP_MB=25
MAX_EXTRACTED_MB=100
MAX_ZIP_ENTRIES=5000
MAX_FILE_MB=1
JOB_MAX_ATTEMPTS=3
WORKER_POLL_MS=700
